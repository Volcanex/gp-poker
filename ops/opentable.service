[Unit]
Description=EveryonePoker, free ranked no-limit hold'em (everyonepoker.com)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/gabriel/gp-poker
# No EnvironmentFile: the server loads the repo .env itself (server/src/config.ts),
# so the secrets live in exactly one place and the unit never holds a copy.
ExecStart=/usr/bin/node release/server/index.js
# always, not on-failure: a SIGTERM from outside systemd ends in the clean
# shutdown path in index.ts, exit 0, which on-failure reads as intended. On
# 2026-09-24 earlyoom SIGTERMed the server at 00:14 under memory pressure and
# the site stayed down for eight hours. `systemctl stop` is never restarted
# whatever this says, so `always` costs nothing there.
Restart=always
RestartSec=3
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=opentable

[Install]
WantedBy=multi-user.target
