{
  "name": "opentable",
  "private": true,
  "version": "0.1.0",
  "description": "Open Table: free ranked heads-up poker (poker.gabrielpenman.com)",
  "type": "module",
  "workspaces": ["packages/*", "server", "client"],
  "scripts": {
    "dev": "npm run build -w client && npm run dev -w server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "start": "npm start -w server"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "tsx": "^4.20.0"
  }
}
